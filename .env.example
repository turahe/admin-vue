# Blog API origin. Leave empty during local development: Vite proxies /api to http://localhost:8080.
# Set an absolute origin for production builds, with no trailing slash.
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Public Sentry DSN for this app. Leave empty to disable reporting.
# Vite inlines this at build time, so production images need it as a build arg.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=

# Build-time source-map upload. Do not prefix these with VITE_; they must stay out of the browser bundle.
# Create a token with project:releases and org:read, then export it only in CI or the Docker build.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=admin-vue
# Optional. When empty, the Vite plugin uses the git commit SHA.
# SENTRY_RELEASE=
